                    $field.css({
                        "border-top-right-radius": "4px",
                        "border-bottom-right-radius": "4px"
                    });
                }

                // Target Whole Number / Integer / Decimal fields explicitly
                if ($field.attr("type") === "number" || $field.hasClass("integer") || $field.hasClass("decimal")) {
                    // Apply strict read-only attribute to prevent keyboard/spinner changes
                    $field.attr("readonly", "readonly");
