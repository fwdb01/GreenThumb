                try {
                    // Parse the JSON array of selected objects
                    var selectedObjects = JSON.parse(valAttr);
                    var selectedValues = selectedObjects.map(item => String(item.Value));
                
                    // Check if ANY selected value is in the triggerValues list
                    isVisible = selectedValues.some(val => config.triggerValues.includes(val));
                } catch (e) {
                    console.error("Error parsing multiselect JSON:", e);
                }
            }

