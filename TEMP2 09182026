const StreetTreeBedsOtherMaterialsFieldName = "gt_streettreebedsothermaterials";
const OtherTreeGuardsConditionFieldName = "gt_othertreeguardscondition";
const TreeBedsNotesFieldName = "gt_treebedsnotes";

// Function to make a field required and add a custom validator
var MakeRequired = function (fieldName) {
    try {
        var $field = $("#" + fieldName);
        if ($field.length > 0) { 
            $field.prop('required', true);
            $field.closest(".control").prev().addClass("required");

            var Requiredvalidator = document.createElement('span');
            Requiredvalidator.style.display = "none";
            Requiredvalidator.id = fieldName + "Validator";
            Requiredvalidator.controltovalidate = fieldName;
            Requiredvalidator.errormessage = `<a href='#${fieldName}_label'>${$(`#${fieldName}_label`).html()} is a required field.</a>`;
            Requiredvalidator.initialvalue = "";
            Requiredvalidator.evaluationfunction = function () {
                var value = getControlValue(fieldName); 
                return (value !== null && value !== "");
            };

            var duplicateFlag = false;
            if (typeof Page_Validators !== 'undefined' && Page_Validators.length > 0) {
                for (let i = 0; i < Page_Validators.length; i++) {
                    if (Requiredvalidator.id === Page_Validators[i].id) {
                        duplicateFlag = true;
                        break;
                    }
                }
            }

            if (duplicateFlag === false && typeof Page_Validators !== 'undefined') {
                Page_Validators.push(Requiredvalidator);
            }  
        }
    }
    catch (error) {
        if (typeof errorHandler === 'function') errorHandler(error);
    }
};

// Function to make a field not required and remove validators
var MakeNotRequired = function (fieldName) {
    try {
        var $field = $("#" + fieldName);
        if ($field.length > 0) { 
            $field.closest(".control").prev().removeClass("required");
            $field.prop('required', false);

            if (typeof Page_Validators !== 'undefined') {
                for (var i = 0; i < Page_Validators.length; i++) {
                    if (Page_Validators[i].id === fieldName + "Validator") {
                        Page_Validators.splice(i, 1);
                        break; 
                    }
                }
            }
        }
    }
    catch (error) {
        if (typeof errorHandler === 'function') errorHandler(error);
    }
};

// Universal Helper utility to extract Choice values accurately on both Desktop & Mobile layouts
var getControlValue = function (fieldName) {
    var $el = $("#" + fieldName);
    if ($el.length === 0) return "";
    
    if ($el.is("select")) {
        return $el.val() || "";
    }
    
    var $checkedRadio = $("input[name='" + fieldName + "']:checked");
    if ($checkedRadio.length > 0) {
        return $checkedRadio.val() || "";
    }
    
    return $el.val() || "";
};

// Add First Breadcrumb to Step 3 of SIF
let displayFirstBreadcrumb = function(){
    let imgPath =  `/GT-Site-Visits-Multistep-Form/GT-Breadcrumbs_0`;
    console.log("Perimeter & Signage" );
    
    var $wizardBar = $(".progress-indicator, .wizard-steps, ul.nav-tabs, .crmEntityFormView .steps");
    
    if($wizardBar.length > 0) {
        let active_index = $wizardBar.find(".active").index();

        $wizardBar.find("li").each(function(){
            let curr_index = $(this).index();

            if($(this).hasClass("active")){
                $wizardBar.find("li:not(.active)").addClass("text-muted hidden").removeClass("incomplete");
                $(this).addClass("new-breadcrumb-active").removeClass("active"); 
                $(this).html(`<img src=${imgPath}${curr_index}.png class=hero-image>`); 
                console.log("This is the dynamic function");
            }
            if(curr_index > active_index ){
                console.log(curr_index + "vs" + active_index );
                $(this).addClass("hidden");
            }
        });
    }
};

