var MakeRequired = function (fieldNameI) {
  
    for(let fieldName of fieldNameI)
    { 
    try {
        if ($("#" + fieldName) != undefined) {
            
            $("#" + fieldName).prop('required', true);
            $("#" + fieldName).closest(".control").prev().addClass("required");

            var Requiredvalidator = document.createElement('span');
            Requiredvalidator.style.display = "none";
            Requiredvalidator.id = fieldName + "Validator";
            Requiredvalidator.controltovalidate = fieldName;
            Requiredvalidator.errormessage = `<a href='#${fieldName}_label'>${$(`#${fieldName}_label`).html()} is a required field.</a>`;
            Requiredvalidator.initialvalue = "";
            Requiredvalidator.evaluationfunction = function (){
                var value = $("#" + fieldName).val();
                if (value == null || value == "") {
                    return false;
                }else {
                    return true;
                }
            };

            // Add the new validator to the page validators array:
            var duplicateFlag = false;
            if(Page_Validators.length > 0){
         
                for(let i = 0; i < Page_Validators.length; i++){
                    
                    let currentItem = Page_Validators[i].id;
                    
                    if(Requiredvalidator.id == currentItem){
                        duplicateFlag = true;
                    }
                }

            }

            if(duplicateFlag === false){
                Page_Validators.push(Requiredvalidator);
            }  
        }
if(displayValidation.includes(fieldName)){  
AddDescriptionValidation(fieldName);
 
} 


    }
    catch (error) {
        errorHandler(error);
    }
}        
}


var MakeNotRequired = function (fieldNameI) {
    for(let fieldName of fieldNameI)
    {    
  var count = 0;
  for(var i =0; i < Page_Validators.length - count; i++){
    if (Page_Validators[i - count].id == "RequiredFieldValidator" + fieldName) {
      Page_Validators.splice(i - count, 1);
      count++;
    }
  }
  $("#" + fieldName + "_label").parent().removeClass("required");
    }
}

var MakeNotRequiredDetails = function (fieldNameI) {
     for(let fieldName of fieldNameI)
    {    
    try {

        var field = $("#" + fieldName);
        if (field != undefined && field.length > 0) {
            field.closest(".control").prev().removeClass("required");
            field.prop("required", false);

            if (typeof (Page_Validators) == "undefined") {
                return;
            }

            for (var i = 0; i < Page_Validators.length; i++) {
                if (Page_Validators[i].id == fieldName + "Validator") {
                    Page_Validators.splice(i, 1);
                    break;
                }
            }
        }
    }
    catch (error) {
        errorHandler(error);
    }
    }
}
 
  

