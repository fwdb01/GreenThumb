function ResetControls(arInspection)
{
    for(let resetControl of arInspection){

        if($('#'+ resetControl).is("select"))
{
$("#"+resetControl).prop('selectedIndex', -1);
}
else if($('#'+ resetControl).is("input")||$('#'+ resetControl).is("textarea"))
{
     $('#'+ resetControl).val(""); 
}
    }
}

