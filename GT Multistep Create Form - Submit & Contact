///////////

        // 1. function to turn the whole form to readyo only
        function applyAllReadOnlyFixes() {
            // A. INJECT GLOBAL CSS (Updated with your specific classes from the screenshot)
            $("<style>")
                .prop("type", "text/css")
                .html(`
                    /* 1. Target the 'Choose File' button classes */
                    .btn-for-image-input, .btn-for-inputofimage, input[type='file'] {
                        display: none !important;
                    }

                    /* 2. Target the 'Delete' button using its specific classes from your DOM */
                    .buttonfordeleteimage, .btnforimage, [id$='_delete_button'] { 
                        display: none !important; 
                        visibility: hidden !important;
                        pointer-events: none !important;
                    }

                    /* 3. Hide the container to be safe */
                    .image-inline button { display: none !important; }

                    /* 4. Visual feedback for read-only multi-selects */
                    .msos-container, .ms-BasePicker-text, .choices__inner { 
                        pointer-events: none !important; 
                        background-color: #f3f3f3 !important; 
                    }
                    .ms-TagItem-close, .choices__button { display: none !important; }
                `)
                .appendTo("head");

