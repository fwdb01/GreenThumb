         // 1. Initial execution checks when form loads 
         toggleReasonForNoAccessToGarden(); 
         toggleReasonForNoAccessToGardenDetails();  
         toggleOtherAccessMethod();
         toggleLockboxLocation();        

         // 2. Bind change events to Choice fields
         $(document).on("change", "#gt_easyaccesstogarden, input[name='gt_easyaccesstogarden']", function() {
             toggleReasonForNoAccessToGarden();
         });

         $(document).on("change", "#gt_reasonfornoaccesstogarden, input[name='gt_reasonfornoaccesstogarden']", function() {
             toggleReasonForNoAccessToGardenDetails();
         }); 
        
         $(document).on("change", "#gt_gardenlockmethod, input[name='gt_gardenlockmethod']", function() {
             toggleOtherAccessMethod();
             toggleLockboxLocation();            
         });  

         // 3. Functions to toggle visibility and required status of dependent fields
         function toggleReasonForNoAccessToGarden() {
            var selectedValue = getControlValue("gt_easyaccesstogarden"); 
        
            // Check for 'No' value (Easy Access to Garden)
            if (selectedValue == "122850001") { // 'No' value
                // FIXED: Target the closest table row container to show everything uniformly
                $("#gt_reasonfornoaccesstogarden").closest("tr").show();
                $("#gt_reasonfornoaccesstogarden_label").show(); 
                MakeRequired(ReasonForNoAccessToGardenFieldName); 
            } else {
                // Safely clear out down-tree sub-dependencies first
                $("#gt_reasonfornoaccesstogardendetails").val('');
                $("#gt_reasonfornoaccesstogardendetails").closest("tr").hide();
                $("#gt_reasonfornoaccesstogardendetails_label").hide(); 
                MakeNotRequired(ReasonForNoAccessToGardenDetailsFieldName);  
                        
                var $reasonEl = $("#gt_reasonfornoaccesstogarden");
                if ($reasonEl.is("select")) {
                    $reasonEl.prop('selectedIndex', -1);
                } else {
                    $("input[name='gt_reasonfornoaccesstogarden']").prop('checked', false);
                }
                
                // FIXED: Target the closest table row container to completely clear duplicates out
                $reasonEl.closest("tr").hide();
                $("#gt_reasonfornoaccesstogarden_label").hide();  
                MakeNotRequired(ReasonForNoAccessToGardenFieldName);
            }        
         }

         // Function to toggle Reason for No Access to Garden Details visibility
         function toggleReasonForNoAccessToGardenDetails() { 
            var selectedValue = getControlValue("gt_reasonfornoaccesstogarden");

            // Check for 'Other' value (Reason for No Access to Garden)
            if (selectedValue == "122850005") { // 'Other' value
                $("#gt_reasonfornoaccesstogardendetails").closest("tr").show();
                $("#gt_reasonfornoaccesstogardendetails_label").show(); 
                MakeRequired(ReasonForNoAccessToGardenDetailsFieldName); 
            } else {
                $("#gt_reasonfornoaccesstogardendetails").val('');
                $("#gt_reasonfornoaccesstogardendetails").closest("tr").hide();
                $("#gt_reasonfornoaccesstogardendetails_label").hide();  
                MakeNotRequired(ReasonForNoAccessToGardenDetailsFieldName);              
            }          
         }

         function toggleLockboxLocation() {
            var selectedValue = getControlValue("gt_gardenlockmethod");
            
            if (selectedValue === "122850003") { // 'Lockbox' value
                $("#gt_lockboxlocation").closest("tr").show();
                $("#gt_lockboxlocation_label").show();
                MakeRequired(LockboxLocationFieldName);                
            } else {
                $("#gt_lockboxlocation").val('');
                $("#gt_lockboxlocation").closest("tr").hide();
                $("#gt_lockboxlocation_label").hide();  
                MakeNotRequired(LockboxLocationFieldName);               
            }            
         }

         // Function to toggle Other Access Method visibility
         function toggleOtherAccessMethod() {
            var selectedValue = getControlValue("gt_gardenlockmethod");
            
            if (selectedValue === "122850004") { // 'Other' value
                $("#gt_otheraccessmethod").closest("tr").show();
                $("#gt_otheraccessmethod_label").show(); 
                MakeRequired(OtherAccessMethodFieldName);                
            } else {
                $("#gt_otheraccessmethod").val('');
                $("#gt_otheraccessmethod").closest("tr").hide();
                $("#gt_otheraccessmethod_label").hide();  
                MakeNotRequired(OtherAccessMethodFieldName);               
            }
         }

        //  End of toggle functions


      });
   }(window.jQuery));
}
